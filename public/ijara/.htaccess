# Ijara paneli — sayt admin panelidan alohida manzil va alohida sessiya.
# Kod umumiy: admin/_lib (u yerdagi .htaccess veb orqali ochilishini taqiqlaydi).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Frame-Options "DENY"
  # Nima uchun bu yerda ham: admin/.htaccess dagi izohga qarang (ildizdagi umumiy qoida PHP yozganini almashtiradi).
  Header set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"

  # Shartnoma skanlari (fayl.php): object-src 'none' bo'lsa brauzer PDF'ni ocholmaydi.
  # <Files> keyin qo'llanadi — shu fayl uchun yuqoridagini almashtiradi. PHP ham xuddi shuni yuboradi.
  <Files "fayl.php">
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; object-src 'self'; frame-ancestors 'none'"
  </Files>
</IfModule>
